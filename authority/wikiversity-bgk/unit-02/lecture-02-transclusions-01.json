brück 2019-2020)/Arbeitsblatt {{{1|}}}{{!}}Arbeitsblatt zur Vorlesung]]\n([[media:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)Arbeitsblatt{{{1|}}}.pdf|PDF]])\n|}<includeonly>[[Kategorie:Kurs:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)/Vorlesungen|Vorlesung]]</includeonly> \n<noinclude>[[Kategorie:Kurs:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)/Hilfsstruktur|Vorlesung/Fuß]]</noinclude>"}}}]},{"pageid":110007,"ns":0,"title":"MDLUL/Isomorphismus von Vektorbündeln (reell)","revisions":[{"revid":597538,"parentid":0,"timestamp":"2019-08-23T14:32:24Z","sha1":"0962efa63655ba9fa6490b7ac9586341ad7b4145","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{MDLUL{{{opt|}}}|Start=Isomorphismus von Vektorbündeln (reell)|Anf=Is|\n|Siehe=\n|Ziel=Topologischer Raum/Reelle Vektorbündel/Isomorphismus/Definition\n}}"}}}]},{"pageid":110008,"ns":0,"title":"MDLUL/Isomorphismen (reelles Vektorbündel)","revisions":[{"revid":597539,"parentid":0,"timestamp":"2019-08-23T14:32:45Z","sha1":"e55c4b47f50bd6bd5c952d1bcb436540ec972bae","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{MDLUL{{{opt|}}}|Start=Isomorphismen (reelles Vektorbündel)|Anf=Is|\n|Siehe=Isomorphismus (reelles Vektorbündel)\n|Ziel=/Definition\n}}"}}}]},{"pageid":110009,"ns":0,"title":"MDLUL/Isomorphismus (reelles Vektorbündel)","revisions":[{"revid":597540,"parentid":0,"timestamp":"2019-08-23T14:32:53Z","sha1":"d8fab5b07a4b02898739f453ac927ea2c0b36e2e","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{MDLUL{{{opt|}}}|Start=Isomorphismus (reelles Vektorbündel)|Anf=Is|\n|Siehe=\n|Ziel=Topologischer Raum/Reelle Vektorbündel/Isomorphismus/Definition\n}}"}}}]},{"pageid":111533,"ns":106,"title":"Kurs:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)/Lineare Gleichung/Drei Variablen/Parameter/Trivialisierungen/Beispiel/Beispielreferenznummer","revisions":[{"revid":601724,"parentid":0,"timestamp":"2019-10-28T15:06:23Z","sha1":"7af800e70c74ef53618205f214879cd57e738a63","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{Nummer im Kurs{{{opt|}}}|Beispiel|1|2|Kurs=|}}"}}}]},{"pageid":111571,"ns":106,"title":"Kurs:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)/Topologisches reelles Vektorbündel/Verklebungsdatum/Existenz/Fakt/Faktreferenznummer","revisions":[{"revid":602213,"parentid":601887,"timestamp":"2019-11-01T15:22:33Z","sha1":"050547ad1db4f04c90499114d0eb8135e9fffe9c","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{Nummer im Kurs{{{opt|}}}|Lemma|2|10|Kurs=|}}"}}}]},{"pageid":111585,"ns":0,"title":"Lineare Gleichung/Drei Variablen/Parameter/Trivialisierungen/Satz vom Igel/Bemerkung","revisions":[{"revid":1035414,"parentid":981707,"timestamp":"2025-08-11T20:49:47Z","sha1":"c1805eab896ccf81159d5483a006265431052b96","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{\nMathematischer Text/Bemerkung{{{opt|}}}\n|Text=\nMit\n{{\nFaktlink\n|Präwort=dem|Satz vom Igel|Faktseitenname=\nSphäre/Satz vom Igel/Fakt\n|Nr=\n|SZ=\n}}\nkönnen wir begründen, dass das Vektorbündel {{math|term= L |SZ=}} über {{mathl|term= \\R^3 \\setminus \\{(0,0,0)\\} |SZ=}} aus\n{{\nBeispiellink\n|Beispielseitenname=\nLineare Gleichung/Drei Variablen/Parameter/Trivialisierungen/Beispiel\n|Nr=\n|SZ=\n}}\nkeine stetige Trivialisierung besitzt. Zunächst ist\n{{\nRelationskette\n|S^2\n| \\subset |\\R^3 \\setminus \\{(0,0,0)\\}\n||\n||\n||\n|SZ=\n}}\neine Teilmenge, sodass wir {{math|term= L |SZ=}} auf {{math|term= S^2 |SZ=}} einschränken können. Wenn {{math|term= L |SZ=}} selbst trivial wäre, so wäre auch diese Einschränkung trivial. Die Einschränkung des Bündels {{math|term= L |SZ=}} auf die Einheitssphäre ist aber das Tangentialbündel der Einheitssphäre, da die Bedingung\n{{\nRelationskette/display\n|ru+sv+tw\n|| 0\n||\n||\n||\n|SZ=\n}}\nals Orthogonalitätsrelation aufgefasst werden kann und der\n{{\nZusatz/Klammer\n|text=extrinsische|\n|ISZ=|ESZ=\n}}\nTangentialraum an einen Ortspunkt {{mathl|term= (r,s,t) |SZ=}} der Sphäre durch diese Orthogonalitätsrelation festgelegt ist. Wenn das Tangentialbündel trivial wäre, so würde es eine stetige Vektorfelder\n{{\nmathkor|term1=\nu\n|und|term2=\nv\n|SZ=\n}}\ngeben, die in jedem Punkt der Sphäre eine Basis des Tangentialraumes bildeten. Der Satz vom Igel sagt aber, dass sogar jedes Vektorfeld eine Nullstelle hat, und {{math|term= 0 |SZ=}} kann nicht Teil einer Basis sein.\n|Textart=Bemerkung \n|Kategorie=Der Satz vom Igel\n|Kategorie2=Theorie der reellen Vektorbündel auf topologischen Räumen\n|Kategorie3=\n|Objektkategorie=\n|Stichwort=\n|Variante=\n|Autor=\n|Bearbeitungsstand=\n}}"}}}]},{"pageid":111642,"ns":106,"title":"Kurs:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)/Topologisches reelles Vektorbündel/Verklebungsdatum/Definition/Definitionreferenznummer","revisions":[{"revid":602198,"parentid":0,"timestamp":"2019-11-01T15:00:00Z","sha1":"ef15c8a5c171156c5ffcdb678e05143b7e29c76e","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{Nummer im Kurs{{{opt|}}}|Definition|2|8|Kurs=|}}"}}}]},{"pageid":111649,"ns":106,"title":"Kurs:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)/Topologischer Raum/Verklebungsdatum/Existenz/Fakt/Faktreferenznummer","revisions":[{"revid":602210,"parentid":0,"timestamp":"2019-11-01T15:21:52Z","sha1":"32175c5794b90ba5b2f1402c937467ddf0d9a9d9","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{Nummer im Kurs{{{opt|}}}|Lemma|2|6|Kurs=|}}"}}}]},{"pageid":111650,"ns":106,"title":"Kurs:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)/Topologischer Raum/Verklebungsdatum/Stetige Abbildung/Fakt/Faktreferenznummer","revisions":[{"revid":602211,"parentid":0,"timestamp":"2019-11-01T15:22:05Z","sha1":"6330463825e14f8cf5f67893d2dd3250a43fd308","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{Nummer im Kurs{{{opt|}}}|Lemma|2|7|Kurs=|}}"}}}]},{"pageid":111652,"ns":106,"title":"Kurs:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)/Möbiusband/Verklebungsdatum/Beispiel/Beispielreferenznummer","revisions":[{"revid":602214,"parentid":0,"timestamp":"2019-11-01T15:22:49Z","sha1":"4674bcfe23f6e0de8819a3d2e8e6b1e365930aa4","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{Nummer im Kurs{{{opt|}}}|Beispiel|2|11|Kurs=|}}"}}}]},{"pageid":111653,"ns":106,"title":"Kurs:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)/Topologischer Raum/Verklebungsdatum/Stetige Abbildung/Fakt/Beweis/Aufgabe/Aufgabereferenznummer","revisions":[{"revid":621564,"parentid":602216,"timestamp":"2020-02-25T13:43:01Z","sha1":"13b5867666bc42408724b8a9a8c876c9b3ea3c6a","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{Nummer im Kurs{{{opt|}}}|Aufgabe|2|18|Kurs=|}}"}}}]},{"pageid":112230,"ns":106,"title":"Kurs:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)/Topologischer Raum/Verklebungsdatum/Äquivalenzrelation/Aufgabe/Aufgabereferenznummer","revisions":[{"revid":604441,"parentid":0,"timestamp":"2019-11-20T13:46:05Z","sha1":"a82e0924fb623c7487373abcb60c5d4d84c4cf36","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{Nummer im Kurs{{{opt|}}}|Aufgabe|2|14|Kurs=|}}"}}}]},{"pageid":112231,"ns":106,"title":"Kurs:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)/Verklebungsdatum/Vektorbündel/Trivialisierungen/Bemerkung/Bemerkungreferenznummer","revisions":[{"revid":604442,"parentid":0,"timestamp":"2019-11-20T13:48:22Z","sha1":"616f56d04713d6119308bec316651123393e6d3f","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{Nummer im Kurs{{{opt|}}}|Bemerkung|2|9|Kurs=|}}"}}}]},{"pageid":112232,"ns":106,"title":"Kurs:Bündel, Garben und Kohomologie (Osnabrück 2019-2020)/Vektorbündel/Matrixbeschreibung/Isomorphie/Aufgabe/Aufgabereferenznummer