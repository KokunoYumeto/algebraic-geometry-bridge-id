SZ=.}} \n{{\ninputfaktbeweis\n|Schnitttheorie von Kurven/Satz von Bézout/Fakt|Satz||\n}}\n\n{{\ninputfaktbeweis\n|Schnitttheorie von Kurven/Satz von Bézout/Es gibt Schnittpunkt/Fakt|Korollar||\n}}\n\n{{\ninputfaktbeweis\n|Schnitttheorie von Kurven/Satz von Bézout/Maximal mn Schnittpunkte/Fakt|Korollar||\n}}\n|Textart=Textabschnitt\n|Kategorie=Der Satz von Bézout (ebene Kurven)\n|Kategorie2=\n|Kategorie3=\n|Objektkategorie=\n|Stichwort=\n|Autor=\n|Bearbeitungsstand=\n|pdf=\n}}"}}}]},{"pageid":51772,"ns":0,"title":"MDLUL/Modulhomomorphismus","revisions":[{"revid":304101,"parentid":0,"timestamp":"2012-03-12T17:37:49Z","sha1":"c6ae0dff950aa7de9d514af4b9f267d2d86df045","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{MDLUL{{{opt|}}}|Start=Modulhomomorphismus|Anf=Mo|\n|Siehe=\n|Ziel=Kommutative_Algebra/Modultheorie/Homomorphismus/Isomorphismus/Endomorphismus/Automorphismus/Definition\n}}"}}}]},{"pageid":53203,"ns":0,"title":"MDLUL/Modulhomomorphismen","revisions":[{"revid":312887,"parentid":0,"timestamp":"2012-05-01T12:07:18Z","sha1":"146f913cc240da317ce753a763363f9465b8ff26","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{MDLUL{{{opt|}}}|Start=Modulhomomorphismen|Anf=Mo|\n|Siehe=Modulhomomorphismus\n|Ziel=/Definition\n}}"}}}]},{"pageid":54439,"ns":106,"title":"Kurs:Algebraische Kurven (Osnabrück 2012)/Schnitttheorie von Kurven/Satz von Bézout/Injektivität der Multiplikation mit Z im homogenen Restklassenring/Fakt/Faktreferenznummer","revisions":[{"revid":1106732,"parentid":322780,"timestamp":"2026-07-12T11:46:19Z","sha1":"e3ec1323c7c8dd3d09a05154b0d94745b9221619","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{Nummer im Kurs{{{opt|}}}|Lemma|30|2|Kurs=|}}"}}}]},{"pageid":54441,"ns":106,"title":"Kurs:Algebraische Kurven (Osnabrück 2012)/Schnitttheorie von Kurven/Satz von Bézout/Fakt/Faktreferenznummer","revisions":[{"revid":1107591,"parentid":322782,"timestamp":