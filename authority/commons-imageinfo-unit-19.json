eclare R1 = 5;\n\nsphere_sweep {   \n  linear_spline\n  2,\n  <-1000,-1000,-1000>,R1\n  < 1000,-1000,-1000>,R1 \n  pigment {rgb 0}\n  no_shadow\n}\nsphere_sweep {   \n  linear_spline\n  2,\n  <-1000, 1000,-1000>,R1\n  < 1000, 1000,-1000>,R1 \n  pigment {rgb 0}\n  no_shadow\n}\nsphere_sweep {   \n  linear_spline\n  2,\n  <-1000, 1000, 1000>,R1\n  < 1000, 1000, 1000>,R1 \n  pigment {rgb 0}\n  no_shadow\n}\nsphere_sweep {   \n  linear_spline\n  2,\n  <-1000,-1000, 1000>,R1\n  < 1000,-1000, 1000>,R1 \n  pigment {rgb 0}\n  no_shadow\n} \nsphere_sweep {   \n  linear_spline\n  2,\n  <-1000,-1000,-1000>,R1\n  <-1000, 1000,-1000>,R1 \n  pigment {rgb 0}\n  no_shadow\n}\nsphere_sweep {   \n  linear_spline\n  2,\n  < 1000,-1000,-1000>,R1\n  < 1000, 1000,-1000>,R1 \n  pigment {rgb 0}\n  no_shadow\n}\nsphere_sweep {   \n  linear_spline\n  2,\n  < 1000,-1000, 1000>,R1\n  < 1000, 1000, 1000>,R1 \n  pigment {rgb 0}\n  no_shadow\n}\nsphere_sweep {   \n  linear_spline\n  2,\n  <-1000,-1000, 1000>,R1\n  <-1000, 1000, 1000>,R1 \n  pigment {rgb 0}\n  no_shadow\n}\nsphere_sweep {   \n  linear_spline\n  2,\n  <-1000,-1000,-1000>,R1\n  <-1000,-1000, 1000>,R1 \n  pigment {rgb 0}\n  no_shadow\n}\nsphere_sweep {   \n  linear_spline\n  2,\n  < 1000,-1000,-1000>,R1\n  < 1000,-1000, 1000>,R1 \n  pigment {rgb 0}\n  no_shadow\n}\nsphere_sweep {   \n  linear_spline\n  2,\n  < 1000, 1000,-1000>,R1\n  < 1000, 1000, 1000>,R1 \n  pigment {rgb 0}\n  no_shadow\n}\nsphere_sweep {   \n  linear_spline\n  2,\n  <-1000, 1000,-1000>,R1\n  <-1000, 1000, 1000>,R1 \n  pigment {rgb 0}\n  no_shadow\n}\n\nparametric {\n            function{v*1000}              \n            function{u*1000}\n            function{u*u*1000}\n            <-1,-1>,<1,1>\n            contained_by{box{<-1000,-1000,-1000>,<1000,1000,1000>}}\n            accuracy 0.00001\n            precompute 20,x,y,z\n            texture {  pigment { color rgbt<0.10, 0.25, 0.85, 0.76> }  }\n            no_shadow\n         }\n         \nparametric {\n      