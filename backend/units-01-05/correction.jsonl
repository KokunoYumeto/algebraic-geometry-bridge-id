{"concept_ids":[],"content_sha256":"d69ebeaebef3f2225931e6f8a5b88314f97b1dfb72edde4e1de0ad3578cf2ac6","edition_id":"edition.algebraic-geometry-bridge-id.units-01-05.2026-08-22","entity_class":"correction","language":"id-ID","order":null,"parent_id":null,"path":null,"payload":{"affected_unit_ids":["br-ak-2025-2026-w02-sol-16"],"authority_observation":"The semantically correct plain-TeX fraction form {1\\over X^2+Y^2+1} is accepted by LuaLaTeX but rejected by Pandoc's TeX-to-MathML converter, leaving one display as raw TeX in HTML.","kind":"typesetting_compatibility","mathematical_effect":"none","publication_gate":"applied_before_publication","scope":"worksheet_solution_2_16_mathml","target_action":"Serialize the identical fraction as \\frac{1}{X^2+Y^2+1}, which converts to MathML and preserves the PDF mathematics."},"prerequisite_ids":[],"provenance":{"authority_identity":"Wikiversity public solution page 94378 revision 1112335 SHA1 f8cdee48d06320bcc5057014a26369e727c364f1; Indonesian Worksheet 2 solution source"},"resource_id":"resource.algebraic-geometry-bridge-id.editorial-layer","responsible_workflow":"workflow.o016-d100.algebraic-geometry-bridge-id","rights_id":"rights.derivative-editorial.cc-by-sa-4.0","schema":"ag-bridge-backend-record","schema_version":"1.0.0","source_local_id":"AGC-ADAPT-0007","source_locator":"00_control/CORRECTIONS.csv","stable_id":"correction.agc-adapt-0007","status":"applied_before_publication","supersedes":null,"timestamp":"2026-08-22T16:27:22.314997+00:00","translation_state":"built"}
{"concept_ids":[],"content_sha256":"ae3490cf244274b3c1614161e3c38fed729ae9dce857f3187d762995a166d87a","edition_id":"edition.algebraic-geometry-bridge-id.unit-01.2026-08-21","entity_class":"correction","language":"id-ID","order":null,"parent_id":null,"path":null,"payload":{"affected_unit_ids":["br-ak-2025-2026-w01-sol-13"],"authority_observation":"The displayed quadratic factor begins with -x^2 but the next sentence calls that displayed factor monic.","kind":"source_precision","mathematical_effect":"semantic_clarification_only","scope":"worksheet_solution_1_13","target_action":"The Indonesian solution says that after multiplication by -1 the quadratic factor is monic; all displayed factors and the root argument remain unchanged.","upstream_report_disposition":"defer_to_single_bounded_post-corpus_report_if_still_material"},"prerequisite_ids":[],"provenance":{"authority_identity":"Wikiversity page 94816 revision 1096436 SHA1 f7f3c55fbba6565f1c11130f18b21323134a45ce"},"resource_id":"resource.brenner.algebraische-kurven.2025-2026","responsible_workflow":"workflow.o016-d100.algebraic-geometry-bridge-id","rights_id":"rights.derivative-editorial.cc-by-sa-4.0","schema":"ag-bridge-backend-record","schema_version":"1.0.0","source_local_id":"AGC-CORR-0001","source_locator":"00_control/CORRECTIONS.csv","stable_id":"correction.agc-corr-0001","status":"applied","supersedes":null,"timestamp":"2026-08-21T17:03:01.487965+00:00","translation_state":"built"}
{"concept_ids":[],"content_sha256":"9681cb2815c40383a4c525bf8639e8c123191b0e3d71546a7f4d3e4c199ace4e","edition_id":"edition.algebraic-geometry-bridge-id.units-01-02.2026-08-22","entity_class":"correction","language":"id-ID","order":null,"parent_id":null,"path":null,"payload":{"affected_unit_ids":["br-ak-2025-2026-w02-ex-16","br-ak-2025-2026-w02-sol-16"],"authority_observation":"The draft Indonesian identity serialized F(X^2+Y^2+1), which denotes function evaluation rather than the source product F multiplied by X^2+Y^2+1.","kind":"derivative_fidelity_fix","mathematical_effect":"restores_source_semantics","publication_gate":"applied_before_publication","scope":"worksheet_2_exercise_2_16","target_action":"Restore the explicit multiplication as F\\cdot(X^2+Y^2+1) in the exercise and its frozen public solution."},"prerequisite_ids":[],"provenance":{"authority_identity":"Wikiversity Worksheet 2 revision 1062654; expanded LaTeX SHA-256 1f3568806f039cdcd7761b7cc21c904ce43daa7636ef31455925b38281b19a64"},"resource_id":"resource.brenner.algebraische-kurven.2025-2026","responsible_workflow":"workflow.o016-d100.algebraic-geometry-bridge-id","rights_id":"rights.derivative-editorial.cc-by-sa-4.0","schema":"ag-bridge-backend-record","schema_version":"1.0.0","source_local_id":"AGC-CORR-0002","source_locator":"00_control/CORRECTIONS.csv","stable_id":"correction.agc-corr-0002","status":"applied_before_publication","supersedes":null,"timestamp":"2026-08-22T04:02:53.428634+00:00","translation_state":"built"}
{"concept_ids":[],"content_sha256":"733b5ed67cb13d3b20d7c74d6f044d2cc71aac786e511923bb87788b8a783797","edition_id":"edition.algebraic-geometry-bridge-id.units-01-02.2026-08-22","entity_class":"correction","language":"id-ID","order":null,"parent_id":null,"path":null,"payload":{"affected_unit_ids":["br-ak-2025-2026-w02-ex-21"],"authority_observation":"The draft Indonesian ideal-power formula contained an extraneous comma in the exponent serialization.","kind":"derivative_fidelity_fix","mathematical_effect":"restores_source_semantics","publication_gate":"applied_before_publication","scope":"worksheet_2_exercise_2_21","target_action":"Replace the malformed exponent with \\widetilde{\\mathfrak a}^{\\,n}, preserving the source identity \\mathfrak a^nS=\\widetilde{\\mathfrak a}^n."},"prerequisite_ids":[],"provenance":{"authority_identity":"Wikiversity Worksheet 2 revision 1062654; expanded LaTeX SHA-256 1f3568806f039cdcd7761b7cc21c904ce43daa7636ef31455925b38281b19a64"},"resource_id":"resource.brenner.algebraische-kurven.2025-2026","responsible_workflow":"workflow.o016-d100.algebraic-geometry-bridge-id","rights_id":"rights.derivative-editorial.cc-by-sa-4.0","schema":"ag-bridge-backend-record","schema_version":"1.0.0","source_local_id":"AGC-CORR-0003","source_locator":"00_control/CORRECTIONS.csv","stable_id":"correction.agc-corr-0003","status":"applied_before_publication","supersedes":null,"timestamp":"2026-08-22T04:02:53.428634+00:00","translation_state":"built"}
{"concept_ids":[],"content_sha256":"d6f14cdf0ae8c49e1d35e9639767137197ce15eacd68840af3746f7f80056215","edition_id":"edition.algebraic-geometry-bridge-id.units-01-02.2026-08-22","entity_class":"correction","language":"id-ID","order":null,"parent_id":null,"path":null,"payload":{"affected_unit_ids":["br-ak-2025-2026-w02-sol-09"],"authority_observation":"The source says both sides are positive on [-1,1], although each side is zero at an endpoint.","kind":"source_precision","mathematical_effect":"semantic_clarification_only","publication_gate":"applied_before_publication","scope":"worksheet_solution_2_09","target_action":"The Indonesian solution says both sides are nonnegative on the interval; the displayed inequality and squaring argument are unchanged."},"prerequisite_ids":[],"provenance":{"authority_identity":"Wikiversity page 90694 revision 1096689 SHA1 067bf0a2f36c434eb3666e61a8da67be431ca96c"},"resource_id":"resource.brenner.algebraische-kurven.2025-2026","responsible_workflow":"workflow.o016-d100.algebraic-geometry-bridge-id","rights_id":"rights.derivative-editorial.cc-by-sa-4.0","schema":"ag-bridge-backend-record","schema_version":"1.0.0","source_local_id":"AGC-CORR-0004","source_locator":"00_control/CORRECTIONS.csv","stable_id":"correction.agc-corr-0004","status":"applied_before_publication","supersedes":null,"timestamp":"2026-08-22T04:02:53.428634+00:00","translation_state":"built"}
{"concept_ids":[],"content_sha256":"f18d0572d847e76afbff1904c1bcca639ba5f8d830d0863f17867eb931120bb3","edition_id":"edition.algebraic-geometry-bridge-id.units-01-04.2026-08-22","entity_class":"correction","language":"id-ID","order":null,"parent_id":null,"path":null,"payload":{"affected_unit_ids":["br-ak-2025-2026-w04-ex-06"],"authority_observation":"The exercise says the zero locus of a prime ideal (p) in K[X] is all of A^1 or a singleton, omitting the empty case; for example (X^2+1) is prime in R[X] and has empty real zero locus.","kind":"source_omission","mathematical_effect":"flags_missing_source_case","publication_gate":"applied_before_publication","scope":"worksheet_4_exercise_4_06","target_action":"Preserve the source task verbatim in translation and add an explicit edition note identifying the omitted empty case without supplying an invented solution."},"prerequisite_ids":[],"provenance":{"authority_identity":"Wikiversity Worksheet 4 revision 1075377; ordered exercise map SHA-256 a6e2631e9b4156d5f32bf5f55c1a201987f9da9c41d247d51755fb8727079420"},"resource_id":"resource.brenner.algebraische-kurven.2025-2026","responsible_workflow":"workflow.o016-d100.algebraic-geometry-bridge-id","rights_id":"rights.derivative-editorial.cc-by-sa-4.0","schema":"ag-bridge-backend-record","schema_version":"1.0.0","source_local_id":"AGC-CORR-0005","source_locator":"00_control/CORRECTIONS.csv","stable_id":"correction.agc-corr-0005","status":"applied_before_publication","supersedes":null,"timestamp":"2026-08-22T06:29:37.231031+00:00","translation_state":"built"}
{"concept_ids":[],"content_sha256":"67992f9c0f8f1f6378562573244b83a1d20c7e859503d974fef021c960ec2717","edition_id":"edition.algebraic-geometry-bridge-id.units-01-04.2026-08-22","entity_class":"correction","language":"id-ID","order":null,"parent_id":null,"path":null,"payload":{"affected_unit_ids":["br-ak-2025-2026-l04-ex-03"],"authority_observation":"After defining E1=V(Z-X) and E2=V(Z+X) and proving the intersection identity for E1, the source says 'likewise for E1' where the parallel case is E2.","kind":"source_referent_typo","mathematical_effect":"restores_intended_referent","publication_gate":"applied_before_publication","scope":"lecture_4_two_cylinders","target_action":"Render the second referent as E2 in Indonesian; preserve every displayed ideal and intersection formula."},"prerequisite_ids":[],"provenance":{"authority_identity":"Wikiversity Lecture 4 revision 1112250; lecture expanded LaTeX SHA-256 12770df1bf47f03532b6331523fdaa146d8f5247cb110e483fd086a362d5dd4c"},"resource_id":"resource.brenner.algebraische-kurven.2025-2026","responsible_workflow":"workflow.o016-d100.algebraic-geometry-bridge-id","rights_id":"rights.derivative-editorial.cc-by-sa-4.0","schema":"ag-bridge-backend-record","schema_version":"1.0.0","source_local_id":"AGC-CORR-0006","source_locator":"00_control/CORRECTIONS.csv","stable_id":"correction.agc-corr-0006","status":"applied_before_publication","supersedes":null,"timestamp":"2026-08-22T06:29:37.231031+00:00","translation_state":"built"}
{"concept_ids":[],"content_sha256":"cd1b1d47ce61e4c22cd7c0bd277f59c2df4c7a8857e0e7b2e43d0a45ea626ea9","edition_id":"edition.algebraic-geometry-bridge-id.units-01-05.2026-08-22","entity_class":"correction","language":"id-ID","order":null,"parent_id":null,"path":null,"payload":{"affected_unit_ids":["br-ak-2025-2026-l05-cor-01-proof"],"authority_observation":"After assigning Y=a and choosing an X-root b, the source calls (a,b) a zero even though the established coordinate order is (X,Y).","kind":"source_coordinate_order","mathematical_effect":"restores_intended_coordinate_order","publication_gate":"applied_before_publication","scope":"lecture_5_noether_corollary","target_action":"State the coordinates separately as X=b and Y=a and add an explicit edition note identifying the source ordering."},"prerequisite_ids":[],"provenance":{"authority_identity":"Wikiversity Lecture 5 revision 1051269; lecture expanded LaTeX SHA-256 d0c5b4243f62c2e1de418b8e29111574dfb96e4cf758895ea32190e843bf9779"},"resource_id":"resource.brenner.algebraische-kurven.2025-2026","responsible_workflow":"workflow.o016-d100.algebraic-geometry-bridge-id","rights_id":"rights.derivative-editorial.cc-by-sa-4.0","schema":"ag-bridge-backend-record","schema_version":"1.0.0","source_local_id":"AGC-CORR-0007","source_locator":"00_control/CORRECTIONS.csv","stable_id":"correction.agc-corr-0007","status":"applied_before_publication","supersedes":null,"timestamp":"2026-08-22T16:27:22.314997+00:00","translation_state":"built"}
{"concept_ids":[],"content_sha256":"0707eae268558725f0416660e8b36046c40e4ce9dd0d463ce50423de60009fc0","edition_id":"edition.algebraic-geometry-bridge-id.units-01-05.2026-08-22","entity_class":"correction","language":"id-ID","order":null,"parent_id":null,"path":null,"payload":{"affected_unit_ids":["br-ak-2025-2026-l05-s03"],"authority_observation":"The source places component functions phi_i in K[X_1,...,X_r], while the map parameters and substitution codomain are consistently T_1,...,T_r.","kind":"source_variable_typo","mathematical_effect":"restores_variable_consistency","publication_gate":"applied_before_publication","scope":"lecture_5_polynomial_map_components","target_action":"Use K[T_1,...,T_r] for the component functions and add an explicit edition note; preserve the substitution homomorphism and every component formula."},"prerequisite_ids":[],"provenance":{"authority_identity":"Wikiversity Lecture 5 revision 1051269; lecture expanded LaTeX SHA-256 d0c5b4243f62c2e1de418b8e29111574dfb96e4cf758895ea32190e843bf9779"},"resource_id":"resource.brenner.algebraische-kurven.2025-2026","responsible_workflow":"workflow.o016-d100.algebraic-geometry-bridge-id","rights_id":"rights.derivative-editorial.cc-by-sa-4.0","schema":"ag-bridge-backend-record","schema_version":"1.0.0","source_local_id":"AGC-CORR-0008","source_locator":"00_control/CORRECTIONS.csv","stable_id":"correction.agc-corr-0008","status":"applied_before_publication","supersedes":null,"timestamp":"2026-08-22T16:27:22.314997+00:00","translation_state":"built"}
{"concept_ids":[],"content_sha256":"7f2c6503d8327f97281c5285ded4beb72cf57094524847c8057fdb01a4bb3b2d","edition_id":"edition.algebraic-geometry-bridge-id.units-01-05.2026-08-22","entity_class":"correction","language":"id-ID","order":null,"parent_id":null,"path":null,"payload":{"affected_unit_ids":["br-ak-2025-2026-w05-sol-03"],"authority_observation":"The source places the leading coefficient a_n inside a product indexed from 1 to n, which would multiply it n times rather than once.","kind":"source_factor_coefficient_typo","mathematical_effect":"restores_intended_factorization","publication_gate":"applied_before_publication","scope":"worksheet_solution_5_03","target_action":"Place a_n once outside both the dehomogenized and rehomogenized products and add an explicit edition note."},"prerequisite_ids":[],"provenance":{"authority_identity":"Wikiversity solution page 168415 revision 1068012 SHA1 b0589aa0817396e302230b00d084db08a1984928"},"resource_id":"resource.brenner.algebraische-kurven.2025-2026","responsible_workflow":"workflow.o016-d100.algebraic-geometry-bridge-id","rights_id":"rights.derivative-editorial.cc-by-sa-4.0","schema":"ag-bridge-backend-record","schema_version":"1.0.0","source_local_id":"AGC-CORR-0009","source_locator":"00_control/CORRECTIONS.csv","stable_id":"correction.agc-corr-0009","status":"applied_before_publication","supersedes":null,"timestamp":"2026-08-22T16:27:22.314997+00:00","translation_state":"built"}
